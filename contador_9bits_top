module contador_9bits_top (input wire clk, input wire rst, input wire speed_sel,
	input wire  pause_state, input wire  descendant_state, input wire  ascendant_state,
	output [6:0] HEX3, output [6:0] HEX2, output [6:0] HEX1, output [6:0] HEX0);
	wire e = 1'b1;
	wire signed [8:0] count;
	wire [8:0] magnitud = count[8] ? (~count + 9'b000000001) : count;
	
	wire tick_clk;
	
	wire [3:0] centena;
	wire [3:0] decena;
	wire [3:0] unidad;
	
	wire descendant_pulse;
	wire ascendant_pulse;
	
	button_onepulse DESCENDANT_PULSE (.clk(clk), .rst(rst), .button_n(descendant_state), .press_pulse(descendant_pulse));
	button_onepulse ASCENDANT_PULSE (.clk(clk), .rst(rst), .button_n(ascendant_state), .press_pulse(ascendant_pulse));
	
	
	tick_generator TICK (.clk(clk), .rst(rst), .e(e), .speed_sel(speed_sel), .tick(tick_clk));
	contador CONT (.clk(clk), .tick(tick_clk), .rst(rst), .pause_state(pause_state), .descendant_state(descendant_pulse), .ascendant_state(ascendant_pulse), .cuenta(count));
	
	bin9_to_bcd3 BINTOBCD (.bin(magnitud), .hund(centena), .tens(decena), .ones(unidad));
	
	Decoder HEX_0 (.b(unidad), .seg(HEX0));
	Decoder HEX_1 (.b(decena), .seg(HEX1));
	Decoder HEX_2 (.b(centena), .seg(HEX2));
	
	assign HEX3 = count[8] ? 7'b1111110 :  7'b1111111;
	
endmodule
