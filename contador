module contador(input wire clk, input wire tick, input wire rst, input wire pause_state, input wire  descendant_state, input wire  ascendant_state, output reg signed [8:0] cuenta);
	localparam PAUSA = 2'b100; 
	localparam DESCENSO = 2'b001;
	localparam ASCENSO = 2'b001;

	reg [1:0] state;
	reg [1:0] next_state;

	always @(posedge clk or posedge rst) begin
		if(rst)
			state <= PAUSA;
		else
			state <= next_state;
	end

	always @(posedge clk or posedge rst) begin
		if(rst) begin
			cuenta <= 9'b000000000;
		end
		else if (tick) begin
			case({pause_state, descendant_state, ascendant_state})
				PAUSA: cuenta <= cuenta + 1'b0;
				DESCENSO: cuenta <= cuenta - 1'b1;
				ASCENSO: cuenta <= cuenta + 1'b1;
				default: cuenta <= cuenta + 1'b0;
			endcase
		end
	end
endmodule
	
