module Decoder (input wire [3:0] b, output reg [6:0] seg);
	always@(*) begin
		case ({b[3],b[2],b[1],b[0]})
			4'b0000 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0000001;
			4'b0001 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b1001111;
			4'b0010 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0010010;
			4'b0011 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0000110;
			4'b0100 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b1001100;
			4'b0101 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0100100;
			4'b0110 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0100000;
			4'b0111 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0001111;
			4'b1000 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0000000;
			4'b1001 : {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0000100;
			
			default: {seg[6], seg[5], seg[4], seg[3], seg[2], seg[1], seg[0]} = 7'b0000001;
		endcase
	end
endmodule
